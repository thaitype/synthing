{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build-tools", "^test"],
      "outputs": []
    },
    "lint:check": {
      "dependsOn": ["build-tools", "^lint:check"],
      "outputs": []
    },
    "lint:fix": {},
    "check-types": {
      "dependsOn": ["build-tools", "^check-types"],
      "outputs": []
    },
    "build-tools": {
      "dependsOn": ["@synthing/mono#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
